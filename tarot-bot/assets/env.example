TELEGRAM_BOT_TOKEN=
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct:fastest
TAROT_SKILL_DIR=/opt/tarot

# --- run mode -------------------------------------------------------------
# webhook (production, needs a domain+SSL) or polling (quick local testing)
RUN_MODE=webhook

# Only used when RUN_MODE=webhook.
WEBHOOK_DOMAIN=amirxo.com
# Public port Telegram calls. Telegram only accepts 443, 80, 88 or 8443.
# 8443 is the default on purpose: it never touches whatever else (e.g.
# Xray/3X-UI) is already bound to 443 on this host.
WEBHOOK_PUBLIC_PORT=8443
# Explicit path is strongly recommended so it matches your Nginx config
# exactly (see deploy/nginx-tarot-bot.conf). If left blank, a path is
# auto-derived from the bot token as a dev fallback.
WEBHOOK_PATH=/webhook/tarot-bot-CHANGE-ME
# Internal address python-telegram-bot listens on; Nginx reverse-proxies
# from WEBHOOK_PUBLIC_PORT to this address. Keep it on localhost.
WEBHOOK_LISTEN=127.0.0.1
WEBHOOK_PORT=8081
# Optional extra check: Telegram sends this back on every webhook request
# (X-Telegram-Bot-Api-Secret-Token header) and PTB rejects mismatches.
# Leave blank to auto-derive one from the bot token.
WEBHOOK_SECRET=
DROP_PENDING_UPDATES=false

GALLERY_PAGE_SIZE=10
LOG_LEVEL=INFO
